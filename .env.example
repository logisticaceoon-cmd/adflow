# ─── SUPABASE ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── ANTHROPIC (Claude IA) ───────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
# Modelos (opcional; override sin redeploy). Defaults en src/lib/ai/models.ts
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_REASONING=claude-sonnet-5

# ─── RESEND (emails) ────────────────────────────────
RESEND_API_KEY=your_resend_api_key
# Remitente verificado en Resend (dominio propio, NO onboarding@resend.dev en prod)
EMAIL_FROM=AdFlow <reportes@tudominio.com>

# ─── SEGURIDAD ──────────────────────────────────────
# Clave de cifrado de tokens en reposo (AES-256-GCM). Generar: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your_32_byte_hex_key

# ─── META / FACEBOOK ────────────────────────────────
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://adflow-brown.vercel.app/api/auth/facebook/callback

# ─── APP ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_cron_secret
